<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#15472B"
                android:centerColor="#113D24"
                android:endColor="#0A2616"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="center">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#1A69F0AE"
                android:endColor="#0069F0AE"
                android:gradientRadius="110dp"
                android:startColor="#2969F0AE"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="136dp"
        android:height="136dp"
        android:drawable="@drawable/img_pantrypulse_icon"
        android:gravity="center" />
</layer-list>
